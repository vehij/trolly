# سرور ایران — souzanbaan.ir
# این فایل را به .env در پوشه‌ی برنامه کپی کنید (هرگز commit نشود)
REGION=ir
PORT=3700
HOST=127.0.0.1
DB_PATH=/home/CPANEL_USER/soozanban-data/votes.db
TRUST_PROXY=1
ALT_URL=https://soozanban.com
GEO_REDIRECT=1
# همان مقدار سرور اروپا
SYNC_SECRET=CHANGE_ME
# سرور ایران همگام‌سازی را شروع می‌کند (ترافیک خروجی از ایران معمولاً بازتر از ورودی است)
SYNC_PEER=https://soozanban.com
# هر چند ثانیه یک بار
SYNC_INTERVAL=300
