# سرور اروپا — soozanban.com
# این فایل را به .env در پوشه‌ی برنامه کپی کنید (هرگز commit نشود)
REGION=intl
PORT=3700
HOST=127.0.0.1
DB_PATH=/home/CPANEL_USER/soozanban-data/votes.db
# پشت Apache/LiteSpeed خود cPanel: 1 — اگر Cloudflare (پراکسی نارنجی) جلوی دامنه است: cloudflare
TRUST_PROXY=1
ALT_URL=https://souzanbaan.ir
GEO_REDIRECT=1
# همان مقدار روی هر دو سرور — با `openssl rand -hex 32` بسازید
SYNC_SECRET=CHANGE_ME
# این سرور همگام‌سازی را شروع نمی‌کند؛ SYNC_PEER خالی می‌ماند
