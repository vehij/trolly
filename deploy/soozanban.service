# /etc/systemd/system/soozanban.service
# CPANEL_USER و مسیرها را جایگزین کنید؛ سپس: systemctl daemon-reload && systemctl enable --now soozanban
[Unit]
Description=Soozanban (دردسرهای سوزن‌بان)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CPANEL_USER
Group=CPANEL_USER
WorkingDirectory=/home/CPANEL_USER/soozanban
ExecStart=/opt/node22/bin/node --disable-warning=ExperimentalWarning server/index.js
Restart=always
RestartSec=3
# امنیت
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/CPANEL_USER/soozanban-data

[Install]
WantedBy=multi-user.target
